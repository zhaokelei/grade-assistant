{
  "manifest_version": 3,
  "name": "读书郎自动阅卷助手",
  "version": "1.1.9",
  "description": "调用大模型API自动批改试卷，根据标准答案和完成度智能打分",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "downloads",
    "alarms"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "timer-worker.js"
      ],
      "matches": [
        "https://single-yue.readboy.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://single-yue.readboy.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://single-yue.readboy.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "lattice.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "自动阅卷助手",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
